{
  "name": "vortex-roblox-launcher",
  "version": "1.2.2",
  "private": true,
  "description": "A Rust/Tauri desktop launcher for Roblox experiences.",
  "scripts": {
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build --ci",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0"
  }
}
